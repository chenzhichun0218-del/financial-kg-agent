# 复制本文件为 .env 并填入真实值
# cp .env.example .env

# LLM API（OpenAI 兼容接口，此处示例为 DeepSeek via LLMOps）
LLMOPS_API_KEY=你的_API_KEY
LLMOPS_BASE_URL=https://llmops.transwarp.io/vibecoding/v1
LLMOPS_MODEL=openai/deepseek-v4-flash

# 语义检索用的 embedding 模型（agent_v3 分级记忆 L3 长期记忆）
LLMOPS_EMBED_MODEL=openai/text-embedding-3-small
